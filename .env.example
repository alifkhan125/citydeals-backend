PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citydeals?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Apple Sign In (must match the iOS bundle identifier / Apple client ID)
APPLE_CLIENT_ID=com.citydeals.app

S3_PUBLIC_BASE_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="CityDeals <no-reply@citydeals.com>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Firebase Admin / FCM
# Option 1: paste the full Firebase service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: set these three instead of FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
