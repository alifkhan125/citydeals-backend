generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADVERTISER
  USER
}

enum CouponStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ContentStatus {
  ACTIVE
  INACTIVE
}

enum RedemptionFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  UNLIMITED
}

model User {
  id                 String   @id @default(uuid())
  fullName           String?
  email              String   @unique
  phoneNumber        String?
  profilePictureUrl  String?
  dateOfBirth        DateTime?
  notificationsPaused Boolean @default(false)
  passwordHash       String
  role               Role     @default(USER)
  status             UserStatus @default(ACTIVE)
  areaId             String?
  preferredLanguage  String   @default("en")
  acceptedTerms      Boolean  @default(false)
  onboardingCompleted Boolean @default(false)
  refreshTokenHash   String?
  resetPasswordOtp   String?
  resetPasswordExpiresAt DateTime?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  fcmToken           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  area                Area?                  @relation(fields: [areaId], references: [id])
  merchants           Merchant[]
  notificationEvents  NotificationCooldown[]
  notifications       Notification[]
  savedCoupons        SavedCoupon[]
  couponRedemptions   CouponRedemption[]
  supportTickets      SupportTicket[]
}

model Area {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  city        String
  state       String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  radiusMeters Int     @default(10000)
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  merchants Merchant[]
  coupons   Coupon[]

  @@index([slug])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  iconUrl   String?
  description String?
  status    ContentStatus @default(ACTIVE)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons   Coupon[]
  merchants Merchant[]

  @@index([slug])
}

model Merchant {
  id          String   @id @default(uuid())
  name        String
  description String?
  titleText   String?
  logoUrl     String?
  categoryId  String?
  areaId      String
  ownerId     String?
  address     String
  phone       String?
  email       String?
  websiteUrl  String?
  instagramUrl String?
  facebookUrl String?
  tiktokUrl   String?
  radiusMeters Int     @default(3000)
  status      ContentStatus @default(ACTIVE)
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  area                  Area                   @relation(fields: [areaId], references: [id])
  owner                 User?                  @relation(fields: [ownerId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  coupons               Coupon[]
  notificationCooldowns NotificationCooldown[]

  @@index([areaId])
  @@index([categoryId])
}

model Coupon {
  id          String       @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  couponCode  String?
  couponLink  String?
  redemptionLimit Int?
  redemptionFrequency RedemptionFrequency @default(ONE_TIME)
  discussion  String?
  terms       String?
  shareSlug   String       @unique
  status      CouponStatus @default(DRAFT)
  startsAt    DateTime?
  expiresAt   DateTime?
  areaId      String
  merchantId  String
  categoryId  String?
  isWhitelisted Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  area     Area     @relation(fields: [areaId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  savedBy  SavedCoupon[]
  redemptions CouponRedemption[]
  shareEvents CouponShareEvent[]
  viewEvents CouponViewEvent[]

  @@index([areaId, status])
  @@index([categoryId])
  @@index([merchantId])
}

model StaffRole {
  id          String   @id @default(uuid())
  name        String   @unique
  key         String   @unique
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffAccount {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  roleKey   String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponRedemption {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([couponId])
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  fullName  String
  email     String
  message   String
  response  String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model LegalDocument {
  id        String   @id @default(uuid())
  type      String   @unique
  title     String
  content   String
  version   String   @default("1.0")
  updatedAt DateTime @updatedAt
}

model SavedCoupon {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}

model NotificationCooldown {
  id         String   @id @default(uuid())
  userId     String
  merchantId String
  lastSentAt DateTime

  user     User     @relation(fields: [userId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([userId, merchantId])
}

model CouponShareEvent {
  id        String   @id @default(uuid())
  couponId  String
  channel   String
  eventType String   @default("SHARE")
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([channel])
  @@index([eventType])
  @@index([createdAt])
}

model CouponViewEvent {
  id        String   @id @default(uuid())
  couponId  String
  userId    String?
  source    String   @default("APP")
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([source])
  @@index([createdAt])
}
